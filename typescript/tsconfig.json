{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/identity/**/*.ts",
    "src/signer/**/*.ts",
    "src/libp2p/**/*.ts",
    "src/stream/**/*.ts",
    "src/webrtc-direct/**/*.ts"
  ]
}
