{
  "name": "bitcoin-libp2p",
  "version": "0.3.1",
  "license": "AGPL-3.0-only",
  "description": "Standard libp2p secp256k1 identity with a typed remote-signer boundary",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "import": "./dist/identity/index.js"
    },
    "./signer": {
      "types": "./dist/signer/index.d.ts",
      "import": "./dist/signer/index.js"
    },
    "./libp2p": {
      "types": "./dist/libp2p/index.d.ts",
      "import": "./dist/libp2p/index.js"
    },
    "./stream": {
      "types": "./dist/stream/index.d.ts",
      "import": "./dist/stream/index.js"
    },
    "./webrtc-direct": {
      "types": "./dist/webrtc-direct/index.d.ts",
      "import": "./dist/webrtc-direct/index.js"
    },
    "./webrtc-interconnect": {
      "types": "./dist/webrtc-interconnect/index.d.ts",
      "import": "./dist/webrtc-interconnect/index.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/index.js.map",
    "dist/index.d.ts.map",
    "dist/identity",
    "dist/signer",
    "dist/libp2p",
    "dist/stream",
    "dist/webrtc-direct",
    "dist/webrtc-interconnect"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@libp2p/crypto": "5.2.0",
    "@libp2p/identify": "4.1.18",
    "@libp2p/interface": "3.4.0",
    "@libp2p/peer-id": "6.0.18",
    "@libp2p/peer-id-factory": "4.2.4",
    "@libp2p/peer-record": "9.0.19",
    "@libp2p/utils": "7.4.5",
    "@libp2p/webrtc": "7.0.2",
    "@libp2p/websockets": "10.1.25",
    "@multiformats/multiaddr": "13.0.3",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "libp2p": "3.5.1",
    "multiformats": "14.0.5"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.7.2"
  }
}
